# systemd unit for the hosted game. Copy to /etc/systemd/system/, then: systemctl daemon-reload && systemctl enable --now we-oddbout
[Unit]
Description=we.oddbout.com (archipelago game)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/we-oddbout/current
# ANTHROPIC_API_KEY lives here (chmod 600), never in the repo
EnvironmentFile=/opt/we-oddbout/env
Environment=PORT=5310 DATA_DIR=/opt/we-oddbout/data SAMPLE=api SITE_ORIGIN=https://we.oddbout.com CLAUDE_PER_USER=5 CLAUDE_PER_DAY=300
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server/main.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
