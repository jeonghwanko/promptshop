# nginx site for we.oddbout.com → the Node server on 127.0.0.1:5310. Copy to /etc/nginx/sites-available/ and link.
# TLS: the VM's certbot has no nginx plugin. Issue with webroot (port 80 serves the challenge), like the VM's other sites:
#   certbot certonly --webroot -w /var/www/letsencrypt -d we.oddbout.com
# Renewal runs from certbot.timer; /etc/letsencrypt/renewal-hooks/deploy/reload-nginx.sh reloads nginx.
server {
  listen 80;
  listen [::]:80;
  server_name we.oddbout.com;
  location ^~ /.well-known/acme-challenge/ {
    root /var/www/letsencrypt;
    default_type text/plain;
  }
  location / { return 301 https://we.oddbout.com$request_uri; }
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name we.oddbout.com;
  ssl_certificate /etc/letsencrypt/live/we.oddbout.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/we.oddbout.com/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  server_tokens off;
  client_max_body_size 1m;
  # the game is plain JS modules (the coastlines alone are 1 MB): compress them here, for this site only
  gzip on; gzip_proxied any; gzip_comp_level 6; gzip_min_length 1024; gzip_vary on;
  gzip_types text/javascript application/javascript text/css application/json image/svg+xml;
  location / {
    proxy_pass http://127.0.0.1:5310;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 40s;        # long polls wait up to 25 s
    proxy_buffering off;           # Claude's answer streams through as it is written
  }
}
