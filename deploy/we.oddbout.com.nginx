# nginx site for we.oddbout.com → the Node server on 127.0.0.1:5310. Copy to /etc/nginx/sites-available/ and link.
# TLS: certbot --nginx -d we.oddbout.com (or the Cloudflare origin certificate if the name is proxied).
server {
  listen 80;
  server_name we.oddbout.com;
  client_max_body_size 1m;
  location / {
    proxy_pass http://127.0.0.1:5310;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 40s;        # long polls wait up to 25 s
    proxy_buffering off;           # Claude's answer streams through as it is written
  }
}
